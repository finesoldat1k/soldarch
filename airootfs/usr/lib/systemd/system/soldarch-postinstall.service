[Unit]
Description=Soldarch Post-Install Setup
Documentation=man:soldarch-postinstall(8)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/soldarch/post-install.done

[Service]
Type=oneshot
ExecStart=/usr/lib/soldarch/soldarch-postinstall.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target