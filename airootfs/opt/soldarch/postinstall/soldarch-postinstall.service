[Unit]
Description=Soldarch Post-Install Setup
Documentation=https://github.com/
After=network.target
ConditionPathExists=!/etc/soldarch/post-install.done

[Service]
Type=oneshot
ExecStart=/usr/lib/soldarch/soldarch-postinstall.sh
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
